    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "postgres": "3.4.9",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
