    "@tldraw/sync-core": "5.3.0",
    "@tldraw/tlschema": "5.3.0",
    "fastify": "5.10.0",
    "postgres": "3.4.9",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
