NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix this key with NEXT_PUBLIC_ or expose it to browsers.
MELD_DEVICE_PAIRING_SERVICE_ROLE_KEY=
# Server-only. Used by the Orion shelf routes (/api/shelf/*). Same local value as above.
MELD_SHELF_SERVICE_ROLE_KEY=
# Server-only. Inspiration auto-sorting (DeepSeek vision). Leave empty to turn sorting off.
DEEPSEEK_API_KEY=
DEEPSEEK_VISION_MODEL=deepseek-flash
RESEND_API_KEY=
INVITATION_FROM_EMAIL="Meld <invitations@example.com>"
INVITATION_EMAIL_TRANSPORT=resend
MAILPIT_URL=
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
INVITATION_TOKEN_SECRET=
GATEWAY_PORT=8787
GATEWAY_SUPABASE_URL=http://127.0.0.1:54321
GATEWAY_SUPABASE_SERVICE_ROLE_KEY=
GATEWAY_POLL_INTERVAL_MS=3000
GATEWAY_HEARTBEAT_SECONDS=30
# Local development and gateway integration fixtures only.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
