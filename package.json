{
  "name": "meld",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "turbo build",
    "check:astryx": "node scripts/check-astryx-conventions.mjs apps/web/src",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "pnpm test:astryx && pnpm test:workspace",
    "test:astryx": "node --test scripts/check-astryx-conventions.test.mjs",
    "test:workspace": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "dependencies": {
    "@boxicons/react": "^1.0.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.1.8",
    "turbo": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
