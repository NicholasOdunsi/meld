{
  "name": "meld",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "overrides": {
      "jsdom": "27.0.0"
    }
  },
  "scripts": {
    "build": "turbo build",
    "check:astryx": "node scripts/check-astryx-conventions.mjs apps/web/src",
    "check:provider-adapters": "bash scripts/provider-adapters/smoke-test.sh --self-test",
    "check:test-colocation": "node scripts/check-test-colocation.mjs apps/web",
    "check:sql-discovery": "node scripts/check-discovery-sql.mjs",
    "check:sql-arities": "node scripts/check-sql-arities.mjs",
    "dev": "turbo dev",
    "lint": "turbo lint && eslint",
    "test": "pnpm test:astryx && pnpm test:colocation && pnpm check:provider-adapters && pnpm test:sql && pnpm test:workspace",
    "test:astryx": "node --test scripts/check-astryx-conventions.test.mjs",
    "test:colocation": "node --test scripts/check-test-colocation.test.mjs && pnpm check:test-colocation",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:sql": "node --test scripts/check-sql-function-arities.test.mjs && pnpm check:sql-arities && pnpm check:sql-discovery",
    "test:workspace": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "dependencies": {
    "@boxicons/react": "1.0.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.1.8",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.0",
    "eslint": "9.39.5",
    "globals": "17.8.0",
    "pgsql-parser": "18.1.1",
    "typescript-eslint": "8.65.0",
    "turbo": "2.10.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
